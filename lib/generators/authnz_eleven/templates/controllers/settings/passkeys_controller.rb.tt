class <%= identity.settings_module %>::PasskeysController < <%= identity.settings_controller %>
<%- if sudoable? -%>
  require_sudo_within <%= identity.config_reference %>.sudo.window,
    message: "Please confirm it's you before adding a passkey.", only: :new
<%- end -%>
  before_action :set_user
  before_action :set_passkey, only: %i[edit update destroy]

  def index
    @passkeys = @user.webauthn_credentials<%= ".passkeys" if passkey_and_security_keys? %>
  end

  def new
    respond_to do |format|
      format.html
      format.json do
        issue_webauthn_challenge(WebAuthn::Credential.options_for_create(
          user: { id: @user.webauthn_handle, name: @user.<%= principals.display.column %> },
          exclude: @user.webauthn_credentials.pluck(:external_id),
          authenticator_selection: { resident_key: "required", user_verification: "required" } # Discoverable, user-verified credentials are required because these passkeys perform passwordless sign-in.
        ))
      end
    end
  end

  def edit
  end

  def create
    @passkey = @user.webauthn_credentials.create!(
      **verify_webauthn_registration(params.expect(credential: {}), user_verification: true),
      name: "Passkey"<%= factor_attr(:first_factor) %>
    )
<%- if security_notifications? -%>
    <%= identity.mailer_class %>.send_security_notification(:passkey_added)
<%- end -%>

    render json: { status: "ok", location: edit_<%= identity.settings_helper_prefix %>_passkey_url(@passkey) }, status: :created
  rescue WebAuthn::Error
    render json: { error: "We couldn't add that passkey. Please try again." }, status: :unprocessable_entity
  end

  def update
    @passkey.update!(name: params[:name])
    redirect_to <%= identity.settings_helper_prefix %>_passkeys_path, notice: "Renamed your passkey.", status: :see_other
  end

  def destroy
    if @user.last_sign_in_method?(:passkey)
      return redirect_to <%= identity.settings_helper_prefix %>_passkeys_path,
        alert: "This is the only way into your account. Add another passkey before removing this one.", status: :see_other
    end

    @passkey.destroy!
<%- if security_notifications? -%>
    <%= identity.mailer_class %>.send_security_notification(:passkey_removed)
<%- end -%>
    redirect_to <%= identity.settings_helper_prefix %>_passkeys_path, notice: "Removed #{@passkey.name}.", status: :see_other
  end

  private

  def set_user
    @user = <%= identity.current_class %>.user
  end

  def set_passkey
    @passkey = @user.webauthn_credentials<%= ".passkeys" if passkey_and_security_keys? %>.find(params[:id]) # Scope the lookup to the signed-in user and first-factor passkeys to prevent cross-account or wrong-factor changes.
  end
end
