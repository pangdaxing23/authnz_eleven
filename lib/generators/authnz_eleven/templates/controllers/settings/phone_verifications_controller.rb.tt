class <%= identity.settings_module %>::PhoneVerificationsController < <%= identity.settings_controller %>
  rate_limit(**<%= identity.config_reference %>.rate_limits.phone_verification, only: :create,
    with: -> { redirect_to new_<%= identity.settings_helper_prefix %>_phone_verification_path, alert: "Too many codes requested. Please try again later." })
  before_action :set_user
  before_action :require_something_to_verify

  def new
  end

  def create
    <%= deferred_call("@user", :request_phone_change_verification) %>

    redirect_to new_<%= identity.settings_helper_prefix %>_phone_verification_path, notice: "We sent you another code."
  end

  def update
    if @user.verify_sms_challenge(params[:code], to: @user.pending_phone) && @user.verify_pending_phone
<%- if security_notifications? -%>
      <%= identity.mailer_class %>.send_security_notification(:phone_changed)
<%- end -%>
      redirect_to <%= identity.settings_helper_prefix %>_path, notice: "Your phone number has been verified.", status: :see_other
    else
      flash.now[:alert] = "That code is incorrect or has expired."
      render :new, status: :unprocessable_entity
    end
  end

  private

  def set_user
    @user = <%= identity.current_class %>.user
  end

  def require_something_to_verify
    return if @user.pending_phone.present?

    redirect_to edit_<%= identity.settings_helper_prefix %>_phone_path, alert: "Add a phone number first."
  end
end
