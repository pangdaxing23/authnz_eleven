class <%= identity.module_name %>::PasswordResetsController < <%= identity.controller_superclass %>
  require_unauthenticated_access
  rate_limit(**<%= identity.config_reference %>.rate_limits.password_reset, only: :create,
    with: -> { redirect_to root_path, alert: "Too many reset links requested. Please try again later." })
  before_action :set_user, only: %i[edit update]

  def new
  end

  def edit
  end

  def create
<%- if captchable? -%>
    unless captcha_verified?
      flash.now[:alert] = "Captcha verification failed. Please try again."
      return render :new, status: :unprocessable_entity
    end

<%- end -%>
<%- if coy? -%>
    <%= deferred_call(identity.class_name, :request_password_reset, "params[:email].to_s") %>
    redirect_to <%= identity.route_scope %>_sign_in_path, notice: "Check your email for password reset instructions."
<%- else -%>
    if <%= identity.class_name %>.request_password_reset(params[:email])
      redirect_to <%= identity.route_scope %>_sign_in_path, notice: "Check your email for password reset instructions."
    else
      redirect_to <%= identity.route_scope %>_forgot_password_path, alert: "No<%= email_verifiable? ? " verified" : "" %> account was found for that email."
    end
<%- end -%>
  end

  def update
    if @user.update(user_params)
<%- if deadboltable? -%>
      @user.undeadbolt!
<%- end -%>
<%- if security_notifications? -%>
      <%= identity.mailer_class %>.send_security_notification(:password_reset, to: @user.email)
<%- end -%>
      redirect_to <%= identity.route_scope %>_sign_in_path, notice: "Your password has been reset. Please sign in.",
        status: :see_other
    else
      render :edit, status: :unprocessable_entity
    end
  end

  private

  def set_user
    @user = <%= identity.class_name %>.find_by_token_for(:password_reset, params.expect(:sid))

    redirect_to_rejection unless @user
  end

  def redirect_to_rejection
    redirect_to <%= identity.route_scope %>_forgot_password_path, alert: "That password reset link is invalid or has expired.",
      status: :see_other
  end

  def user_params
    params.permit(:password, :password_confirmation)
  end
end
