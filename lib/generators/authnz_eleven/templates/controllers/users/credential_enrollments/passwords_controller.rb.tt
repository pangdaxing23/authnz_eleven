class <%= identity.module_name %>::CredentialEnrollments::PasswordsController < <%= identity.controller_superclass %>
  include <%= identity.authentication_concern %>::Registering

  require_unauthenticated_access
  rate_limit(**<%= identity.config_reference %>.rate_limits.sign_up, only: :create,
    with: -> { redirect_to <%= identity.route_scope %>_new_registration_password_path, alert: "Too many attempts. Please try again later." })
  before_action :set_registration

  def new
  end

  def create
    return render :new, status: :unprocessable_entity unless @registration.update(password_params)

    advance(@registration)
  end

  private

  def set_registration
    @registration = <%= identity.pending_registration_class %>.unexpired.find_by(id: session[:<%= pending_registration_session_key %>])
    redirect_to <%= identity.route_scope %>_sign_up_path unless @registration
  end

  def password_params
    params.permit(:password, :password_confirmation)
  end
end
