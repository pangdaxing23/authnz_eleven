class <%= identity.module_name %>::MultiFactorAuthentication::Challenge::RecoveryCodesController < <%= identity.controller_superclass %>
  require_unauthenticated_access
  rate_limit(**<%= identity.config_reference %>.rate_limits.recovery_code_challenge, only: :create,
    with: -> { redirect_to new_<%= identity.route_scope %>_mfa_challenge_recovery_codes_path, alert: "Too many attempts. Please try again later." })
  before_action :set_user

  def new
  end

  def create
    if <%= identity.recovery_code_class %>.redeem(user: @user, code: params[:code])
<%- if rememberable? -%>
      start_new_session_for(@user, via: :second_factor, remember: session.delete(:<%= session_key(:remember_me) %>)) # Keep recovery-code sign-in in the shared session funnel so bans, invitation claims, and session policy still apply.
<%- else -%>
      start_new_session_for(@user, via: :second_factor) # Keep recovery-code sign-in in the shared session funnel so bans, invitation claims, and session policy still apply.
<%- end -%>
      redirect_to after_authentication_url, status: :see_other
    else
      redirect_to new_<%= identity.route_scope %>_mfa_challenge_recovery_codes_path, alert: "That code is incorrect."
    end
  end

  private

  def set_user
    @user = <%= identity.class_name %>.find_by_token_for!(:authentication_challenge, session[:<%= session_key(:challenge_token) %>])
  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
    redirect_to <%= identity.route_scope %>_sign_in_path, alert: "Your sign-in challenge has expired. Please sign in again."
  end
end
