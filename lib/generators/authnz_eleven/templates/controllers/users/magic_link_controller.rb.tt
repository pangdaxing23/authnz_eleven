class <%= identity.module_name %>::MagicLinkController < <%= identity.controller_superclass %>
  require_unauthenticated_access
  rate_limit(**<%= identity.config_reference %>.rate_limits.magic_link, only: :create,
    with: -> { redirect_to <%= identity.route_scope %>_new_magic_link_path, alert: "Too many sign-in links requested. Please try again later." })
  before_action :set_user, only: :edit

  def new
  end

  def edit
  end

  def update
    @user = <%= identity.class_name %>.consume_magic_link(params.expect(:sid))
    return redirect_to_rejection unless @user

    <%= sign_in_call("@user", via: :magic_link) %>
    redirect_to after_authentication_url, status: :see_other
  end

  def create
<%- if captchable? -%>
    unless captcha_verified?
      flash.now[:alert] = "Captcha verification failed. Please try again."
      return render :new, status: :unprocessable_entity
    end

<%- end -%>
<%- if coy? -%>
    <%= deferred_call(identity.class_name, :request_magic_link, "params[:email].to_s") %>
    redirect_to <%= identity.route_scope %>_sign_in_path, notice: "Check your email for a sign in link."
<%- else -%>
    if <%= identity.class_name %>.request_magic_link(params[:email])
      redirect_to <%= identity.route_scope %>_sign_in_path, notice: "Check your email for a sign in link."
    else
      redirect_to <%= identity.route_scope %>_new_magic_link_path, alert: "No account was found for that email."
    end
<%- end -%>
  end

  private

  def set_user
    token = params.expect(:sid)
    @user = <%= identity.class_name %>.find_by_token_for(:magic_link, token)

    redirect_to_rejection unless @user && Rails.cache.exist?(@user.magic_link_nonce_key)
  end

  def redirect_to_rejection
    redirect_to <%= identity.route_scope %>_sign_in_path, alert: "That magic link is invalid or has expired."
  end
end
