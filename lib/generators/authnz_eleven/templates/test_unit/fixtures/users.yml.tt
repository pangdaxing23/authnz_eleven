alice:
<%- if principals.email -%>
  email: alice@example.com
<%- end -%>
<%- if principals.phone -%>
  phone: "+14155550141"
<%- end -%>
<%- if principals.username -%>
  username: alice
<%- end -%>
<%- if password? -%>
  password_digest: <%%= BCrypt::Password.create("quilted-lantern-moss-97", cost: 4) %>
<%- end -%>
<%- if totp? -%>
  totp_secret: <%%= ROTP::Base32.random %>
<%- end -%>
<%- if adminable? -%>
  admin: true
<%- end -%>
<%- if webauthn_credentials? -%>
  webauthn_handle: <%%= WebAuthn.generate_user_id %>
<%- end -%>

