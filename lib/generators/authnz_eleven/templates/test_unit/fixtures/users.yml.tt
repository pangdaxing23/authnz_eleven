<%- if password? -%>
  password_digest: <%%= BCrypt::Password.create("quilted-lantern-moss-97", cost: 4) %>
<%- end -%>
<%- if totp? -%>
  totp_secret: <%%= ROTP::Base32.random %>
<%- end -%>
<%- if adminable? -%>
