require "test_helper"

class <%= identity.password_history_class %>ReuseTest < ActiveSupport::TestCase
  setup { @user = <%= identity.plural %>(:bob) }

  test "rejects changing the password to the current one" do
    assert_not @user.update(password: "quilted-lantern-moss-97", password_confirmation: "quilted-lantern-moss-97")
    assert_includes @user.errors[:password], "was used recently. Please choose a different one"
  end

  test "rejects reusing a recently-used password" do
    @user.update!(password: "FirstChange1", password_confirmation: "FirstChange1")

    assert_not @user.update(password: "quilted-lantern-moss-97", password_confirmation: "quilted-lantern-moss-97")
    assert @user.errors[:password].any?
  end

  test "accepts a genuinely new password and archives the digest it replaced" do
    assert_difference -> { @user.password_histories.count }, 1 do
      assert @user.update(password: "BrandNew1234", password_confirmation: "BrandNew1234"),
             @user.errors.full_messages.to_sentence
    end
  end

  test "a later save of the same record does not re-check the new password" do
    @user.update!(password: "BrandNew1234", password_confirmation: "BrandNew1234")

    assert @user.update(updated_at: Time.current), @user.errors.full_messages.to_sentence
  end

  test "keeps only the configured depth of history" do
    depth = <%= identity.config_reference %>.password.history_depth

    (1..depth + 2).each do |i|
      @user.update!(password: "Rotation#{i}pw", password_confirmation: "Rotation#{i}pw")
    end

    assert_equal depth, @user.password_histories.count
  end

  test "forgets a password once it falls past the depth window" do
    depth = <%= identity.config_reference %>.password.history_depth

    (1..depth + 1).each do |i|
      @user.update!(password: "Rotation#{i}pw", password_confirmation: "Rotation#{i}pw")
    end

    assert @user.update(password: "quilted-lantern-moss-97", password_confirmation: "quilted-lantern-moss-97"),
           @user.errors.full_messages.to_sentence
  end
end
