require "test_helper"

class <%= identity.module_name %>::PasswordRotationTest < ActionDispatch::IntegrationTest
  setup { @user = <%= identity.plural %>(:bob) }

  test "a <%= identity.singular %> with an expired password is held at the change-password page" do
    expire_password
    assert_not @user.reload.password_fresh?
    sign_in_as @user

    get <%= identity.settings_helper_prefix %>_path
    assert_redirected_to edit_<%= identity.settings_helper_prefix %>_password_path
  end

  test "the change-password page itself stays reachable while held" do
    expire_password
    sign_in_as @user

    get edit_<%= identity.settings_helper_prefix %>_password_path
    assert_response :success
  end

  test "signing out is allowed even while held (never trapped in purgatory)" do
    expire_password
    sign_in_as @user

    assert_difference -> { @user.sessions.count }, -1 do
      delete <%= identity.route_scope %>_sign_out_path
    end
    assert_response :redirect
  end

  test "a <%= identity.singular %> with a current password passes the gate" do
    assert @user.password_fresh?, "fixture password should start fresh"
    sign_in_as @user

    get <%= identity.settings_helper_prefix %>_path
    assert_response :success
  end

  test "changing the password clears the gate" do
    expire_password
    sign_in_as @user

    patch <%= identity.settings_helper_prefix %>_password_path, params: {
      password_challenge: "quilted-lantern-moss-97",
      password: "amber-thicket-90-vale",
      password_confirmation: "amber-thicket-90-vale"
    }
    assert @user.reload.password_fresh?, "a fresh password stamps password_changed_at"

    get <%= identity.settings_helper_prefix %>_path
    assert_response :success
  end

  private

  def expire_password
    # Bypass the password-change callback so it does not replace the backdated timestamp.
    @user.update_column(:password_changed_at, (<%= identity.config_reference %>.password.maximum_age + 1.day).ago)
  end

  def sign_in_as(user)
    post <%= identity.route_scope %>_sign_in_path,
      params: { <%= sign_in_field %>: user.<%= login_field %>, password: "quilted-lantern-moss-97" }
  end
end
