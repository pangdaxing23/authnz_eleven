require "test_helper"

class <%= identity.module_name %>::PasswordResetsControllerTest < ActionDispatch::IntegrationTest
  include ActionMailer::TestHelper

  setup { @user = <%= identity.plural %>(:alice) }

  test "requesting a reset for a known account emails a link" do
    assert_enqueued_emails 1 do
      post <%= identity.route_scope %>_reset_password_path, params: { email: @user.email }
    end
    assert_redirected_to <%= identity.route_scope %>_sign_in_path
  end

<%- if coy? -%>
  test "requesting a reset for an unknown email gives nothing away" do
    assert_no_enqueued_emails do
      post <%= identity.route_scope %>_reset_password_path, params: { email: "nobody-#{SecureRandom.hex(4)}@example.com" }
    end
    assert_redirected_to <%= identity.route_scope %>_sign_in_path
  end
<%- else -%>
  test "requesting a reset for an unknown email is told no account exists" do
    assert_no_enqueued_emails do
      post <%= identity.route_scope %>_reset_password_path, params: { email: "nobody-#{SecureRandom.hex(4)}@example.com" }
    end
    assert_redirected_to <%= identity.route_scope %>_forgot_password_path
  end
<%- end -%>

  test "a valid reset token opens the change-password form" do
    token = @user.generate_token_for(:password_reset)
    get <%= identity.route_scope %>_reset_password_path(sid: token)
    assert_response :success
  end

  test "a valid reset token changes the password" do
    token = @user.generate_token_for(:password_reset)
    patch <%= identity.route_scope %>_reset_password_path(sid: token),
      params: { password: "heron-basalt-drift-41", password_confirmation: "heron-basalt-drift-41" }
    assert_redirected_to <%= identity.route_scope %>_sign_in_path
    assert @user.reload.authenticate("heron-basalt-drift-41"), "the new password should verify"
  end

  test "a reset link is dead once it has been used" do
    token = @user.generate_token_for(:password_reset)
    patch <%= identity.route_scope %>_reset_password_path(sid: token),
      params: { password: "heron-basalt-drift-41", password_confirmation: "heron-basalt-drift-41" }

    get <%= identity.route_scope %>_reset_password_path(sid: token)
    assert_redirected_to <%= identity.route_scope %>_forgot_password_path
  end

  test "an invalid or expired reset link is refused" do
    get <%= identity.route_scope %>_reset_password_path(sid: "not-a-real-token")
    assert_redirected_to <%= identity.route_scope %>_forgot_password_path
  end
end
