require "test_helper"

class <%= identity.module_name %>::CredentialEnrollmentTest < ActionDispatch::IntegrationTest
  test "an unfinished registration does not create an account" do
    assert_no_difference -> { <%= identity.class_name %>.count } do
      post <%= identity.route_scope %>_sign_up_path, params: sign_up_params
    end

<%- if invite_only? -%>
    assert_not <%= identity.pending_registration_class %>.exists?, "admission is required before staging"
<%- else -%>
    assert <%= identity.pending_registration_class %>.exists?
<%- end -%>
  end

<%- if pre_account_password_enrollment? -%>
  test "password and account commit together" do
    registration = stage_registration_awaiting_credential

    assert_difference -> { <%= identity.class_name %>.count }, 1 do
      post <%= identity.route_scope %>_registration_password_path,
        params: { password: "Correct horse battery staple 42!", password_confirmation: "Correct horse battery staple 42!" }
    end

    assert_not <%= identity.pending_registration_class %>.exists?(registration.id)
  end

  test "the password step enforces the password rules" do
    stage_registration_awaiting_credential

    assert_no_difference -> { <%= identity.class_name %>.count } do
      post <%= identity.route_scope %>_registration_password_path, params: { password: "a", password_confirmation: "a" }
    end
    assert_response :unprocessable_entity

    assert_no_difference -> { <%= identity.class_name %>.count } do
      post <%= identity.route_scope %>_registration_password_path,
        params: { password: "Correct horse battery staple 42!", password_confirmation: "Something else entirely 42!" }
    end
    assert_response :unprocessable_entity
  end
<%- end -%>
<%- if pre_account_provider_enrollment? -%>

  test "connecting a provider from the finish-setup page completes the sign-up" do
    request_validation = OmniAuth.config.request_validation_phase
    OmniAuth.config.request_validation_phase = nil
    OmniAuth.config.test_mode = true
    OmniAuth.config.mock_auth[:developer] = OmniAuth::AuthHash.new(provider: "developer", uid: "finishing-setup")
    stage_registration_awaiting_credential

    assert_difference -> { <%= identity.class_name %>.count }, 1 do
      post "<%= omniauth_path_prefix %>/developer?registration_intent=1"
      follow_redirect!
    end
    assert <%= identity.omniauth_identity_class %>.exists?(uid: "finishing-setup")
    assert cookies[:<%= identity.cookie_name %>].present?
  ensure
    OmniAuth.config.mock_auth[:developer] = nil
    OmniAuth.config.test_mode = false
    OmniAuth.config.request_validation_phase = request_validation
  end
<%- end -%>

  private
<%- if pre_account_password_enrollment? || pre_account_provider_enrollment? -%>

  def stage_registration_awaiting_credential
    post <%= identity.route_scope %>_sign_up_path, params: sign_up_params
    registration = <%= identity.pending_registration_class %>.last
<%- if email_verifiable? -%>
    registration.update!(email_verified_at: Time.current)
<%- end -%>
<%- if phone_verifiable? -%>
    registration.update!(phone_verified_at: Time.current)
<%- end -%>
    registration
  end
<%- end -%>

  def sign_up_params
    <%= sign_up_fixture_literal(indent: 4) %>
  end
end
