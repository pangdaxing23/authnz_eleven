require "test_helper"

class <%= identity.module_name %>::GuestAccessTest < ActionDispatch::IntegrationTest
<%- if timeoutable? -%>
  include ActiveSupport::Testing::TimeHelpers

<%- end -%>
  class ProbeController < <%= identity.controller_superclass %>
    allow_guest_access

    def show
      render plain: "#{<%= identity.current_class %>.user&.id}:#{<%= identity.current_class %>.user&.guest?}:#{authenticated?}"
    end

    def sign_in
      <%= sign_in_call("#{identity.class_name}.find(params[:id])", via: :second_factor, may_challenge: false) %>
      head :ok
    end
  end

  setup { @<%= identity.singular %> = <%= identity.plural %>(:bob) }

  test "an anonymous visitor is admitted and given a guest identity" do
    with_probe_routes do
      assert_difference -> { <%= identity.class_name %>.guests.count }, +1 do
        get "/guest_probe"
      end

      assert_response :success
      assert_equal "#{<%= identity.class_name %>.guests.last.id}:true:false", response.body
      assert_equal "guest", <%= identity.class_name %>.guests.last.sessions.sole.via,
        "creating a guest does not sign them in"
    end
  end

  test "a guest cookie persists until the guest expires" do
    with_probe_routes do
      get "/guest_probe"
      guest = <%= identity.class_name %>.guests.last
      expires = Time.httpdate(session_cookie_header[/expires=([^;]+)/i, 1])

      assert_in_delta (guest.created_at + <%= identity.config_reference %>.guest.ttl).to_f,
        expires.to_f, 1
    end
  end

  test "the same guest is reused across requests" do
    with_probe_routes do
      get "/guest_probe"
      first = response.body

      assert_no_difference -> { <%= identity.class_name %>.guests.count } do
        get "/guest_probe"
      end

      assert_equal first, response.body
    end
  end
<%- if timeoutable? -%>

  test "a guest outlives the idle timeout that would expire a signed-in session" do
    with_probe_routes do
      get "/guest_probe"
      guest = response.body

      travel <%= identity.config_reference %>.session.idle_timeout + 1.day do
        get "/guest_probe"

        assert_equal guest, response.body, "the guest should still be the same row"
        assert_nil flash[:alert], "a guest was never signed in, so nothing expired"
      end
    end
  end
<%- end -%>

  test "signing in absorbs the guest and destroys it" do
    with_probe_routes do
      get "/guest_probe"
      guest = <%= identity.class_name %>.guests.last

      assert_difference -> { <%= identity.class_name %>.guests.count }, -1 do
        post "/guest_probe/sign_in/#{@<%= identity.singular %>.id}"
      end

      assert_no_match(/expires=/i, session_cookie_header,
        "signing in must not inherit the guest cookie's persistence")
      assert_nil <%= identity.class_name %>.find_by(id: guest.id),
        "the guest row is destroyed once its state has been handed to the account"

      get "/guest_probe"
      assert_equal "#{@<%= identity.singular %>.id}:false:true", response.body
    end
  end

  private

  def session_cookie_header
    Array(response.headers["Set-Cookie"])
      .flat_map { |line| line.to_s.split("\n") }
      .find { |line| line.start_with?("<%= identity.cookie_name %>=") }.to_s
  end

  def with_probe_routes
    # Keep requests and assertions inside this block; with_routing uses a separate integration session and discards its cookies afterward.
    with_routing do |set|
      set.draw do
        get "guest_probe", to: ProbeController.action(:show)
        post "guest_probe/sign_in/:id", to: ProbeController.action(:sign_in)
      end
      yield
    end
  end
end
