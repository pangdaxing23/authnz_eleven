module <%= identity.class_name %>::Invitable
  extend ActiveSupport::Concern

  included do
<%- if teams? -%>
    has_many :accepted_invitations, class_name: "<%= identity.invitation_class %>", foreign_key: :invitee_id, inverse_of: :invitee, dependent: :destroy
<%- else -%>
    has_one :invitation, foreign_key: :invitee_id, inverse_of: :invitee, dependent: :destroy
<%- end -%>
    has_many :sent_invitations, class_name: "<%= identity.invitation_class %>", foreign_key: :inviter_id, inverse_of: :inviter, dependent: :destroy
  end
end
