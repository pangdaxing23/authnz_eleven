module <%= identity.class_name %>::PasswordHistorical
  extend ActiveSupport::Concern

  included do
    has_many :password_histories, dependent: :delete_all

    validate :password_not_recently_used, if: :will_save_change_to_password_digest?

    after_update if: :password_digest_previously_changed? do
      password_histories.create!(password_digest: password_digest_previously_was)
      depth = <%= identity.config_reference %>.password.history_depth
      password_histories.order(id: :desc).offset(depth).destroy_all if depth
    end
  end

  private

  def password_not_recently_used
    depth = <%= identity.config_reference %>.password.history_depth
    return if depth.nil?

    recent = password_histories.order(id: :desc).limit(depth).pluck(:password_digest)
    recent << password_digest_in_database if password_digest_in_database.present?
    if recent.any? { |digest| self.class.new(password_digest: digest).authenticate(password) }
      errors.add(:password, "was used recently. Please choose a different one")
    end
  end
end
