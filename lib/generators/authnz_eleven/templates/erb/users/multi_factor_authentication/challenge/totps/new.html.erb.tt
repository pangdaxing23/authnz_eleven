<p style="color: red"><%%= alert %></p>

<h1>Two-factor authentication</h1>

<p>Enter the 6-digit code from your authenticator app.</p>

<%%= form_with url: <%= identity.route_scope %>_mfa_challenge_totp_path, method: :post do |form| %>
  <div>
    <%%= form.label :code %><br>
    <%%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric" %>
  </div>

  <div><%%= form.submit "Verify" %></div>
<%% end %>

<p><%%= link_to "Use a recovery code instead", new_<%= identity.route_scope %>_mfa_challenge_recovery_codes_path %></p>
<%- second_factor_alternatives(:totp).each do |clause, label, path| -%>
<%% if <%= clause %> %>
  <p><%%= link_to "<%= label %>", <%= path %> %></p>
<%% end %>
<%- end -%>
