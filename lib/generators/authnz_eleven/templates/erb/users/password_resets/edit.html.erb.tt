<p style="color: green"><%%= notice %></p>
<p style="color: red"><%%= alert %></p>

<h1>Reset your password</h1>

<%% if @user.errors.any? %>
  <ul style="color: red">
    <%% @user.errors.full_messages.each do |message| %>
      <li><%%= message %></li>
    <%% end %>
  </ul>
<%% end %>

<%%= form_with url: <%= identity.route_scope %>_reset_password_path(sid: params[:sid]), method: :patch do |form| %>
  <div>
    <%%= form.label :password, "New password" %><br>
    <%%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password" %>
  </div>

  <div>
    <%%= form.label :password_confirmation %><br>
    <%%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  </div>

  <div><%%= form.submit "Reset password" %></div>
<%% end %>
