# Generated by authnz_eleven <%= AuthnzEleven::VERSION %> with:
#
<%- generation_command_lines.each do |line| -%>
#   <%= line %>
<%- end -%>
#
# Configuration for your generated auth system. Adjust them to suit
# your needs.
#
# <%= identity.config_constant %> is an alias for <%= identity.config_storage %>.
# Both refer to the same config, so you can use either. The generated code uses
# <%= identity.config_constant %>.
<%= identity.config_storage %> = ActiveSupport::OrderedOptions.new
<%= identity.config_constant %> = <%= identity.config_storage %>

<%= identity.config_constant %>.tap do |config|
  # Shown as the issuer in authenticator apps and used in mailer subjects.
  config.app_name = Rails.application.class.module_parent_name

  # How often to save a session's last activity to the database. No need to
  # write it on every request.
  config.session = ActiveSupport::OrderedOptions.new
  config.session.activity_write_interval = 15.minutes
<%- if timeoutable? -%>
  # Sign out sessions after they are inactive for this long. They are deleted on the user's
  # next request. For users who never come back, run the included cleanup task:
  # `authnz_eleven:delete_timed_out_sessions`.
  config.session.idle_timeout = 7.days
<%- end -%>
<%- if rememberable? -%>
  # How long the "remember me" cookie lasts. Without "remember me", the cookie
  # lasts only until the browser closes.
  config.session.remember_for = 2.weeks
<%- end -%>
<%- if max_sessionable? -%>
  # How many devices a <%= identity.singular %> can be signed in on at once.
  # "Remember me" sessions count too. If a new sign-in would exceed the limit,
<%- if max_sessions_prompt? -%>
  # the user is held at the session list until they sign one out
  # (--max-sessionable=prompt). Set to nil to allow any number of sessions.
<%- else -%>
  # the least-recently-active session is signed out to make room
  # (--max-sessionable=evict). Set to nil to allow any number of sessions.
<%- end -%>
  config.session.concurrent_limit = 3
<%- end -%>
<%- if guestable? -%>

  # How long to keep a guest <%= identity.singular %>. This is measured from creation, not last activity.
  # Guests are not authenticated, so we don't "sign them out" due to inactivity.
<%- if timeoutable? -%>
  # session.idle_timeout does not apply to guests.
<%- end -%>
  # The guest cookie lives for this long too, including across browser restarts.
  # Run `authnz_eleven:delete_expired_guests` to delete expired guests.
  config.guest = ActiveSupport::OrderedOptions.new
  config.guest.ttl = 30.days
<%- end -%>
<%- if impersonatable? -%>

  # How long an admin can impersonate another <%= identity.singular %>. Activity does
  # not extend this. Once it expires, the next request returns the admin to the
  # admin area as themselves, and that request is not carried out, since it was made
  # as someone else.
  config.impersonation = ActiveSupport::OrderedOptions.new
  config.impersonation.duration = 1.hour
<%- end -%>

<%- if principals.username -%>
  # Usernames nobody may register, like "admin" or "support". Edit
  # config/forbidden_usernames.txt to add or remove names, or replace this with
  # your own list. It must be a Set of downcased strings. Blank lines and "#"
  # comments in the file are ignored.
  #
  # To change the format or the 3–20 character limit, edit the model's `format:`
  # validation. When sign-in accepts multiple identifiers, it checks for "@"
  # first (email), then a letter (username), otherwise it tries a phone number.
  # Keep usernames free of "@" and require at least one letter so they cannot
  # be mistaken for either.
  config.username = ActiveSupport::OrderedOptions.new
  config.username.forbidden = File.readlines(Rails.root.join("config/forbidden_usernames.txt"), chomp: true)
    .map { |line| line.strip.downcase }
    .reject { |line| line.empty? || line.start_with?("#") }
    .to_set

<%- end -%>
<%- if principals.phone -%>
  # Interpret numbers without "+" using this country:
  #   "US": (415) 826-4001 → +14158264001
  #   "GB": 020 7183 8750 → +442071838750
  # An array, like %w[US GB], tries countries in order.
  # Numbers with "+" already specify their country and ignore this default.
  # This controls parsing, not which countries are allowed.
  # Keep a default to avoid guessing from leading digits. Without one, a
  # number from Gainesville, Florida (Go Gators! 🐊), (352) 555-0166, is parsed
  # as +352 5550166 (Luxembourg).
  config.phone = ActiveSupport::OrderedOptions.new
  config.phone.default_country = %w[US CA]

  # Accepted phone-number countries. nil allows all countries.
  config.phone.allowed_countries = nil
  # config.phone.allowed_countries = %w[US CA]

<%- end -%>
<%- if password? -%>
  # Password rules.
  config.password = ActiveSupport::OrderedOptions.new
  config.password.minimum_length = 10
<%- if password_rotatable? -%>
  # Require a new password after this long. On their next request, the user is
  # held at the change-password page until they change it. Set to nil to stop
  # expiring passwords.
  #
  # I do not recommend scheduled rotation unless your compliance policy requires
  # it. NIST SP 800-63B advises against it because it encourages predictable
  # passwords. Prefer longer passwords and breach-checking (--pwned).
  config.password.maximum_age = 90.days
<%- end -%>
<%- if password_historical? -%>
  # How many previous passwords to check when refusing password reuse. The
  # current password is also checked. Stored digests are small, so you can raise
  # this if your policy requires a longer history. Set to nil to keep archiving
  # passwords without rejecting reuse.
  config.password.history_depth = 5
<%- end -%>
<%- if strong_passwords? -%>
  # Minimum zxcvbn strength score (0–4). 3 is "safely unguessable", and 4 is the
  # strictest. Passwords scoring below this are rejected by the Authenticatable
  # concern.
  config.password.minimum_strength = 3
<%- end -%>
<%- if pwned? -%>

  # Check new passwords against Have I Been Pwned. Enabled only in production
  # because it makes an HTTP request and would reject the test fixture passwords.
  config.password.check_breaches = Rails.env.production?
<%- end -%>

<%- end -%>
  # How long links, codes, and challenges remain valid.
  config.tokens = ActiveSupport::OrderedOptions.new
<%- if email_gated_registration? -%>
  config.tokens.registration_email_verification = 2.days
<%- end -%>
<%- if email_change_verification? -%>
  config.tokens.email_change_verification = 2.days
<%- end -%>
<%- if recoverable? -%>
  config.tokens.password_reset = 20.minutes
<%- end -%>
<%- if magic_link? -%>
  config.tokens.magic_link = 20.minutes
<%- end -%>
<%- if second_factor? -%>
  config.tokens.mfa_challenge = 20.minutes
<%- end -%>
<%- if invitable? -%>
  config.tokens.invitation = 7.days
<%- end -%>
<%- if sms? -%>
  config.tokens.sms_code = 10.minutes
<%- end -%>
<%- if pending_registration? -%>
  # How long an unfinished sign-up can sit before cleanup deletes it. Each step,
  # and each link or code sent, restarts the clock. Keep this longer than the
  # registration links above so cleanup doesn't delete a sign-up whose link is
  # still valid.
  config.tokens.pending_registration = 3.days
<%- end -%>
<%- if second_factor? -%>

  # Second-factor authentication.
  config.second_factor = ActiveSupport::OrderedOptions.new
<%- if totp? -%>
  config.second_factor.totp_drift_behind = 10
<%- end -%>
  config.second_factor.recovery_code_count = 10
  config.second_factor.recovery_code_length = 10

  # Which sign-in methods require a second factor, if the user has enrolled one.
  # Methods not listed are accepted on their own. Passkey sign-in is not listed
  # by default because it is already phishing-resistant.
  #
  # Adjust this to suit your security/convenience trade-off. For example, add
  # :magic_link if access to the user's inbox is not enough for your app.
  #
<%- if omniauth? -%>
  # For social login, use the provider name, not :omniauth. For example, :google
  # for google_oauth2. Add providers if you don't want to rely on their own MFA.
  # :omniauth itself matches nothing.
  #
<%- end -%>
  # Do not add :second_factor. It is used after a successful second-factor
  # challenge, so requiring another would cause a redirect loop. :registration
  # is also unnecessary: a newly created account has no second factor yet.
  config.second_factor.needed_after = %i[<%= default_needed_after.join(" ") %>]
<%- end -%>

<%- if deadboltable? -%>
  # How many consecutive failed password sign-ins deadbolt the password door,
  # and how long it stays shut. Once the duration passes, it unlocks and the
  # count starts over. A completed password reset unlocks it early, or you can
  # call `user.undeadbolt!` yourself.
  #
  # Other sign-in methods still work. An attacker guessing at someone's password
  # should not also lock them out of their passkey or magic link.
  #
  # Set maximum_attempts to nil to count failures without locking password
  # sign-in.
  config.deadbolt = ActiveSupport::OrderedOptions.new
  config.deadbolt.maximum_attempts = 10
  config.deadbolt.duration = 1.day

<%- end -%>
<%- if sms? -%>
  # Wrong guesses allowed per texted code. This is separate from the rate limits,
  # which limit how often codes can be sent.
  config.sms = ActiveSupport::OrderedOptions.new
  config.sms.max_attempts = 3

<%- end -%>
  # Request limits, written as { to: number_of_requests, within: duration }.
  # Limits sends, not guesses.
  config.rate_limits = ActiveSupport::OrderedOptions.new
<%- if password? -%>
  config.rate_limits.sign_in = { to: 10, within: 10.minutes }
<%- end -%>
<%- if recoverable? -%>
  config.rate_limits.password_reset = { to: 3, within: 1.hour }
<%- end -%>
<%- if second_factor? -%>
<%- if totp? -%>
  config.rate_limits.totp_challenge = { to: 10, within: 5.minutes }
<%- end -%>
<%- if sms_second_factor? -%>
  config.rate_limits.sms_second_factor = { to: 5, within: 1.hour }
<%- end -%>
  config.rate_limits.recovery_code_challenge = { to: 10, within: 1.hour }
<%- end -%>
<%- if magic_link? -%>
  config.rate_limits.magic_link = { to: 10, within: 1.hour }
<%- end -%>
<%- if email_verifiable? -%>
  # Requests and resends for email confirmation.
  config.rate_limits.email_verification = { to: 5, within: 1.hour }
<%- end -%>
<%- if invitable? -%>
  config.rate_limits.invitation = { to: 5, within: 1.hour }
<%- end -%>
<%- if phone_verifiable? -%>
  # Requests and resends for phone confirmation. Every text costs money.
  config.rate_limits.phone_verification = { to: 5, within: 1.hour }
<%- end -%>
<%- if sms_code? -%>
  # Texted sign-in codes. These typically cost more than emails.
  config.rate_limits.sms_sign_in = { to: 5, within: 1.hour }
<%- end -%>
<%- if sudoable? -%>
  # Failed sudo challenges per session. Successful confirmation resets the count.
  config.rate_limits.sudo = { to: 10, within: 10.minutes }
<%- end -%>
<%- if sudoable? -%>

  # How long a sudo confirmation keeps protected pages unlocked.
  config.sudo = ActiveSupport::OrderedOptions.new
  config.sudo.window = 15.minutes
<%- end -%>
<%- if password? -%>
  # Submission limits for settings forms that require the current password.
  config.rate_limits.password_challenge = { to: 5, within: 10.minutes }
<%- end -%>
<%- if typed_registration? -%>
  config.rate_limits.sign_up = { to: 5, within: 1.hour }
<%- end -%>
end
